    {
      "name": "3. Recibo (8083) - flujo principal",
      "item": [
        {
          "name": "POST Registrar recibo (queda PENDIENTE)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set(\"idRecibo\", pm.response.json().id);",
                  "pm.test(\"Estado PENDIENTE\", function () { pm.expect(pm.response.json().estadoPago).to.eql(\"PENDIENTE\"); });"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// fecha de vencimiento = hoy + 15 dias (formato AAAA-MM-DD)",
                  "const f = new Date(); f.setDate(f.getDate() + 15);",
                  "pm.collectionVariables.set(\"fechaVencimiento\", f.toISOString().substring(0, 10));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "http://localhost:8083/api/recibos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idCliente\": {{idCliente}},\n  \"idServicio\": {{idServicio}},\n  \"periodo\": \"2026-11\",\n  \"monto\": 45.9,\n  \"fechaVencimiento\": \"{{fechaVencimiento}}\"\n}",
